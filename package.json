{
  "name": "wp2payload",
  "version": "0.0.2",
  "description": "Migrate WordPress sites into Payload CMS: posts, pages, media, SEO and redirects.",
  "license": "MIT",
  "author": "Abdul Rehman (https://github.com/abdulrehmankz1)",
  "type": "module",
  "bin": {
    "wp2payload": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulrehmankz1/wp2payload.git"
  },
  "homepage": "https://github.com/abdulrehmankz1/wp2payload#readme",
  "bugs": {
    "url": "https://github.com/abdulrehmankz1/wp2payload/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "wordpress",
    "migration",
    "cli",
    "headless-cms"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "fixture:up": "docker compose up -d",
    "fixture:seed": "node scripts/fixture-seed.mjs",
    "fixture:down": "docker compose down -v",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "domhandler": "^6.0.1",
    "file-type": "^22.2.0",
    "htmlparser2": "^12.0.0",
    "jiti": "^2.7.0",
    "sanitize-html": "^2.18.1",
    "sharp": "~0.35.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "payload": "^3.92.0"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "graphql": "^16.14.2",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
