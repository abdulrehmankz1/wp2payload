# Copy to .env. Never commit real values.

# Target Payload project (already in your Payload .env)
PAYLOAD_SECRET=
DATABASE_URI=

# WordPress source (REST). For the local fixture, `pnpm fixture:seed` writes these into .env.
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# Optional
# WP2P_NO_HINT=1
# NO_COLOR=1
